# message files for non-C locales - ie: local .msg files.  So much
# nicer :)

# $(srcdir), so that this also works in a build directory.
# The files made here (LOC_BUILT, not BUILT_SOURCES: make dist builds
# BUILT_SOURCES, and these need the locale).
LOC_BUILT = $(patsubst %.msg,%.cat,$(filter-out libAB%,$(notdir $(wildcard $(srcdir)/*.msg))))
CLEANFILES = $(LOC_BUILT) $(LOC_BUILT:=.tmp)

msgcatdir = $(CDE_DATA_TOP)/lib/nls/msg/$(LANG)
# (made here, so not in the tarball: a tarball can be made from a tree
# that builds no other locale than C)
nodist_msgcat_DATA = $(LOC_BUILT)

SUFFIXES = .msg .cat

.msg.cat:
	$(RM) $@ $@.tmp
	LANG=$(LANG) $(GENCAT) $@.tmp $^ && mv -f $@.tmp $@

SYM2NUM_CMD = $(KSH) $(top_builddir)/programs/dtprintinfo/sym2num

dtprintinfo.cat: export CPP := $(CPP) -
dtprintinfo.cat: export LANG := $(LANG)
dtprintinfo.cat: export LC_COLLATE = C

dtprintinfo.cat: dtprintinfo.msg
	$(RM) $@ $@.tmp
	$(SYM2NUM_CMD) $(@:.cat=) $< > tmp.msg
	$(GENCAT) $@.tmp tmp.msg && mv -f $@.tmp $@
	$(RM) tmp.msg $(@:.cat=_msg.h)
