# process the app-defaults files...



# The files made here (LOC_BUILT, not BUILT_SOURCES: make dist builds
# BUILT_SOURCES, and these need the locale).
LOC_BUILT = Dthelpview Dtimsstart Dtlogin Dthello Dtsession		\
	Dtscreen Dtwm Dtfile Dtstyle Dtpad Dticon Dtcreate Dtcalc	\
	Dtcm Dtterm Dtmail Dtbuilder Dt Dtinfo

CLEANFILES = $(LOC_BUILT) $(LOC_BUILT:=.tmp)

appdefdir = $(CDE_DATA_TOP)/app-defaults/$(LANG)
# (made here, so not in the tarball: a tarball can be made from a tree
# that builds no other locale than C)
nodist_appdef_DATA = $(LOC_BUILT)

TOP = $(top_builddir)/programs
DTSVCSRC = $(top_builddir)/lib/DtSvc
MERGE = $(top_builddir)/programs/localized/util/merge


Dthelpview: $(TOP)/dthelp/dthelpview/Dthelpview Dthelpview.tmsg
	$(MERGE) -lang $(LANG) $(srcdir)/$@.tmsg < $< > $@.tmp && mv -f $@.tmp $@

