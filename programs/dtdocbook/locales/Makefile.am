MAINTAINERCLEANFILES = Makefile.in

# The DocBook locale strings, for the languages that are being built
# (el_GR.UTF-8 has no switch of its own).
SUBDIRS = el_GR.UTF-8 en_US.UTF-8

if GERMAN
SUBDIRS += de_DE.UTF-8
endif

if SPANISH
SUBDIRS += es_ES.UTF-8
endif

if FRENCH
SUBDIRS += fr_FR.UTF-8
endif

if ITALIAN
SUBDIRS += it_IT.UTF-8
endif

if JAPANESE
SUBDIRS += ja_JP.UTF-8
endif
