# This unit installs the various data that goes with the help SDL files
# like the graphics and the hf files.


# The files are listed by make itself ($(wildcard), relative to $(srcdir)
# so that a VPATH build finds them), not by a shell running find, ls and
# grep each time make reads a variable.
sdl_srcfiles = $(patsubst $(srcdir)/%,%,$(wildcard $(srcdir)/$(1)))

# install the common graphics files
cmngraphdir = $(CDE_DATA_TOP)/appconfig/help/$(LANG)/graphics
dist_cmngraph_DATA = $(call sdl_srcfiles,common/graphics/*)

# install the common/*.hf files, which configure makes from common/*.hf.in
# (in the build directory)
hfdirdir = $(CDE_DATA_TOP)/appconfig/help/$(LANG)
nodist_hfdir_DATA = $(patsubst %.in,%,$(call sdl_srcfiles,common/*.hf.in))

# Now, install any graphics assets found for each help section

# NOTE: we filter out any graphics/CDR directories here - these contain RIFF
# files.  It does not appear they are, or ever have been used, but we will
# restrain the urge to delete them all from the repo for now.

# Appmanager
appmanagerdir = $(CDE_DATA_TOP)/appconfig/help/$(LANG)/Appmanager/graphics
dist_appmanager_DATA = $(filter-out %/CDR,$(call sdl_srcfiles,Appmanager/graphics/*))

# AppBuilder
